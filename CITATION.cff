    given-names: Arhan
    affiliation: Quantavane
    email: arhan@quantavane.com
license: CC-BY-4.0
url: "https://quantavane.com"
repository-code: "https://github.com/arhancanli/quantavane-gw-data"
date-released: "2026-11-14"
keywords:
  - Gallai-van der Waerden numbers
  - arithmetic progressions
  - rainbow progressions
  - SAT certificates
  - LRAT proofs
